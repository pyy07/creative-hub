# OpenAI 兼容接口配置
# 支持 OpenAI 官方接口及所有兼容 OpenAI 格式的第三方服务（如 Azure OpenAI、DeepSeek、通义千问等）

# API Key（必填）
OPENAI_API_KEY="your_api_key_here"

# API Base URL（可选，默认为 OpenAI 官方）
# 使用第三方兼容服务时修改此项，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Azure:     https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
OPENAI_BASE_URL="https://api.openai.com/v1"

# 使用的模型名称（可选，默认 gpt-4o-mini）
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: 应用部署地址（可选）
APP_URL="http://localhost:3000"

# 访问密码（必填）
ADMIN_PASSWORD="your_password_here"

# JWT 签名密钥（必填，生产环境请设置为随机强密钥）
JWT_SECRET="your_jwt_secret_here"
